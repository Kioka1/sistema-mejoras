# Copia este archivo como .env y genera una clave privada aleatoria.
# Ejemplo desde backend/: .\venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
# No compartas .env ni subas su contenido al repositorio.
JWT_SECRET_KEY=

# En producción sustituye los ejemplos por el origen HTTPS público exacto.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=true

# En desarrollo local, si el navegador no admite Secure por HTTP en localhost,
# configura SESSION_COOKIE_SECURE=false. En producción mantén true.

# Configura la conexión de PostgreSQL sin usar una cuenta superusuario.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sistema_mejoras
# DB_USER=
# DB_PASSWORD=
# GOOGLE_CLIENT_ID=
